{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy13",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "597e0bc1-73f3-4d86-8619-91bb1ba19584","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5a1391b223ed486493654e8e88e43050" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
